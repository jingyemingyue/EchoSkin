/* EchoSkin: Midnight Studio
 *
 * Layered AFTER ReverbScope's stock style sheet (reverbscope/ui/theme.py
 * stylesheet()), so only rules that differ from stock are written here.
 * Colours come from skin.json -> tokens.colors (same keys as theme.py's
 * DARK_TOKENS); the hex values below must match those tokens.
 *
 * Every selector targets a widget class or a dynamic property that
 * ReverbScope main actually sets (setProperty / label(text, role)).
 * Main sets only one objectName ("finding"), and that widget carries its own
 * inline style sheet, so this skin does not target objectNames.
 * scripts/check_skins.py verifies the selectors against a checkout of main.
 *
 * Tokens: bg #0e1116  surface #161b22  surface_alt #1c2330  border #2a3340
 *         text #e6e9ee  muted #9aa4b2  accent #3fb0bf  accent_hover #5cc3cf
 *         accent_text #0b1014  accent_soft #173038
 */

/* Rounder corners than stock (2px): cards, group boxes, inputs, buttons */
QFrame[card="true"], QGroupBox {
    border-radius: 6px;
}
QGroupBox QGroupBox {
    border-radius: 4px;
}
QPushButton {
    border-radius: 6px;
    padding: 4px 14px;
}
QPushButton:hover {
    border-color: #5cc3cf;
}
QPushButton[primary="true"] {
    border-radius: 6px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    border-radius: 6px;
}
QToolButton {
    border-radius: 4px;
}

/* Typography: section titles and key figures (StatTile) */
QLabel[role="title"] {
    font-size: 18px;
    font-weight: 700;
}
QLabel[role="kpi-value"] {
    font-size: 22px;
    font-weight: 600;
}
QLabel[role="kpi-label"] {
    letter-spacing: 0.4px;
}

/* View tabs (the analysis view bar) and side-panel switch */
QWidget[viewbar="true"], QWidget[subviewbar="true"] {
    background: #0e1116;
}
QToolButton[viewtab="true"]:checked {
    color: #3fb0bf;
    border-bottom: 2px solid #3fb0bf;
}
QToolButton[panelswitch="true"]:checked {
    color: #e6e9ee;
    background: #173038;
}

/* Side panels and the measurement list */
QWidget[panel="true"] {
    background: #161b22;
}
QTreeWidget[measurements="true"]::item:selected {
    background: #173038;
    color: #e6e9ee;
}

/* Bottom measure strip: teal line while a take is running */
QWidget[strip="true"] {
    background: #0e1116;
}
QWidget[strip="true"][measuring="true"] {
    border-top: 2px solid #3fb0bf;
}

/* Tabs */
QTabWidget::pane {
    border-radius: 6px;
}
QTabBar::tab:selected {
    color: #3fb0bf;
}

/* Splitters: hairline on the canvas, teal on hover */
QSplitter::handle {
    background: #0e1116;
}
QSplitter::handle:hover {
    background: #3fb0bf;
}

/* Scrollbars */
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #2a3340;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #3fb0bf;
}

/* Charts are not styled by QSS: ReverbScope's plots read theme tokens
 * (surface, text, grid, muted), which come from skin.json -> tokens.colors.
 * Series colours (theme.PLOT_SERIES) are not a token on main and stay stock. */
